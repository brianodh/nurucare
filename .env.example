# NuruCare - Environment Variables
# Copy this file to .env and fill in the values.
# The authoritative list is maintained here: every variable the app reads via
# os.getenv(...) should appear below, with a short comment explaining the
# default and where it is consumed.

# ---------------------------------------------------------------------------
# Runtime / deployment
# ---------------------------------------------------------------------------
# Set to "production" or "prod" to enable fail-fast startup checks: the
# backend will refuse to boot if SECRET_KEY is still the default below, or
# if ALLOWED_ORIGINS is empty. Acceptable values (case-insensitive):
#   development | dev | production | prod
ENVIRONMENT=development

# Comma-separated list of origins permitted to make credentialed requests
# to the API. The wildcard "*" must NOT be used together with credentials.
# Leave empty in development — main.py will default to localhost
# 5173/3000 variants with a warning. In production this MUST be explicit.
# Example: http://localhost:5173,https://app.nurucare.example.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT signing secret. CHANGE THIS BEFORE DEPLOYING TO PRODUCTION.
# The backend will refuse to boot in ENVIRONMENT=production if this value
# is still the dev default below.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=nurucare-dev-secret-change-in-production

# Session token TTL. auth.py defaults this to 30 minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo mode. When true, disables some auth gates for smoke-testing dashboards.
# Defaults to False (case-insensitive).
# DEMO_MODE=false

# Nurse session code TTL. `ussd.session_manager` defaults to 1 hour.
# SESSION_EXPIRY_HOURS=1

# ---------------------------------------------------------------------------
# Storage / database
# ---------------------------------------------------------------------------
# "local" (writes to backend/storage/ JSON files) or "supabase" (uses the
# SUPABASE_URL / SUPABASE_KEY pair below). database.py defaults to "local".
STORAGE_BACKEND=local

# PostgreSQL connection. Used by db/database.py (the optional RAG store) and
# by Supabase-fallback paths. Defaults to a local PG URL if unset.
# DATABASE_URL=postgresql://postgres:newpassword@localhost:5432/nurucare

# Supabase (optional — STORAGE_BACKEND=supabase uses these).
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------------------------
# Google AI Studio API key used by ai_client.py and the optional RAG
# pipeline. If unset, ai_client logs a [FATAL] warning on every call and
# returns a clearly-marked rules-engine fallback narrative instead of
# pretending to be AI.
GEMINI_API_KEY=

# Optional — model name passed to google.generativeai.GenerativeModel.
# ai_client defaults to "gemini-1.5-flash".
# GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Redis (optional — USSD session store)
# ---------------------------------------------------------------------------
# Single-URL form takes priority. Host/port/password are used as a fallback
# if REDIS_URL is empty. If all Redis vars are empty, session_manager falls
# back to an in-memory dict (NOT suitable for multi-process deployments).
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Vite API URL for frontend dev server. vite.config.js also defines an
# /api → localhost:8000 proxy, so this is most useful for builds/deployed
# frontends that need to reach a remote backend.
VITE_API_URL=http://localhost:8000
