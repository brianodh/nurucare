# NuruCare - Environment Variables
# Copy this file to .env and fill in the values

# Secret key for JWT tokens (generate a strong secret in production)
SECRET_KEY=nurucare-dev-secret-change-in-production

# Vite API URL for frontend
VITE_API_URL=http://localhost:8000

# Supabase configuration (optional, use local PostgreSQL if not set)
SUPABASE_URL=
SUPABASE_KEY=

# Gemini API key for AI recommendations (optional)
GEMINI_API_KEY=
